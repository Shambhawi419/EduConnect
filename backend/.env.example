# Copy to .env and fill in real values. Never commit the filled-in .env.
PORT=5000
NODE_ENV=development

# Local: mongodb://127.0.0.1:27017/educonnect
# Production: your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/educonnect

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Must be true in production (HTTPS). Also required for cross-site cookies.
COOKIE_SECURE=false

# 'lax' for local dev (same host). Set to 'none' in production when the frontend
# is on a different domain than the API — otherwise the browser drops the cookies.
COOKIE_SAMESITE=lax

OPENAI_API_KEY=

# Origin allowed to call this API with credentials.
CLIENT_URL=http://localhost:5173

# Copy to .env.local for development. Never commit the filled-in file.

# Local: mongodb://127.0.0.1:27017/educonnect
# Production: your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/educonnect

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m

OPENAI_API_KEY=
